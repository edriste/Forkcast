# Public values only. This file is served to browsers; no server/provider secrets.
EXPO_PUBLIC_SUPABASE_URL=https://api.forkcast.example.com
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_OSM_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
EXPO_PUBLIC_OSM_DARK_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Optional: same public VAPID key used by the background push worker.
EXPO_PUBLIC_WEB_PUSH_KEY=
