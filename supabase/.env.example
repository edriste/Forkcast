# Optional identification for requests to public OSM services. Use an app name
# and an operator contact URL/email when deploying beyond local development.
OSM_USER_AGENT="Forkcast/1.0 (internal colleague lunch planner)"
# Optional: replace public services with an operator-managed provider.
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Server-only local Auth credentials. Export before starting Supabase.
# Then enable [auth.external.google] in config.toml. Never use EXPO_PUBLIC_.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Optional server-only walking matrix key from https://account.heigit.org/
# Add to the Edge Function environment, never to an EXPO_PUBLIC_ variable.
OPENROUTESERVICE_API_KEY=

# Optional operator-hosted walking matrix endpoint. This permits keyless private ORS servers.
# OPENROUTESERVICE_MATRIX_URL=http://your-routing-host/ors/v2/matrix/foot-walking
