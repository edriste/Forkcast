{
  "name": "forkcast",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.27",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "maplibre-gl": "^6.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.2",
    "deno": "^2.9.6",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run tests/concurrency.test.ts",
    "export": "expo export --platform all",
    "check": "npm run typecheck && npm test",
    "format": "prettier --write App.tsx app.config.ts index.ts src tests supabase/functions README.md docs package.json tsconfig.json playwright.config.ts .prettierrc.json vitest.config.mts scripts",
    "format:check": "prettier --check App.tsx app.config.ts index.ts src tests supabase/functions README.md docs package.json tsconfig.json playwright.config.ts .prettierrc.json vitest.config.mts scripts",
    "test:ui:build": "EXPO_NO_DOTENV=1 EXPO_PUBLIC_SUPABASE_URL=https://forkcast-test.supabase.co EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=test-public-key expo export --clear --platform web --output-dir /tmp/forkcast-test-web && node scripts/prepare-web.mjs /tmp/forkcast-test-web",
    "test:ui": "playwright test",
    "edge:check": "deno check supabase/functions/places/index.ts",
    "postinstall": "node scripts/copy-map-worker.mjs",
    "edge:test": "deno test --allow-env supabase/functions/_shared/geoapify_test.ts supabase/functions/places/index_test.ts supabase/functions/_shared/walking_test.ts",
    "build:web": "expo export --clear --platform web --output-dir dist && node scripts/prepare-web.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@9.9.0+sha512.60c18acd138bff695d339be6ad13f7e936eea6745660d4cc4a776d5247c540d0edee1a563695c183a66eb917ef88f2b4feb1fc25f32a7adcadc7aaf3438e99c1",
  "license": "MIT"
}
